	"BobiCreatedByAt": {
		"prefix": "bcreated",
		"description": "Output a Created By and Created At field with Bobi",
		"body": [
			"+: {CreatedBy: Bobi, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: ${1:Bobi}, Tags: [${2:CSVTODO}], Estimation:${3:}, RemTime:${4:}}"
		]
	},
	"HanaCreatedByAt": {
