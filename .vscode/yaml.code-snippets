	"StandupReportEntry": {
		"prefix": "srentry",
		"description": "Outputs a standup report entry",
		"body": [
			"[${1:DURATION}, \"$0\", $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND]",
		]
	},
	"BobiTask":{
		"prefix": "btask",
    "body": [
      "${2:TODO} .${1:Summary}:",
      "  Id: ${3:Id}",
      "  +: {CreatedBy: Bobi, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: [${4:Bobi}], ForRequirement: , Estimation: $5, RemTime: $5 }",
      "  Details: $0",
      "  Notes: ",
      "  Workspace: ",
    ],
    "description": "An Item of type \"Task\""
  },
  "HanaTask": {
    "prefix": "htask",
    "body": [
      "${2:TODO} .${1:Summary}:",
      "  Id: ${3:Id}",
      "  +: {CreatedBy: Hana, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: [${4:Hana}], ForRequirement: , Estimation: $5, RemTime: $5 }",
      "  Details: $0",
      "  Notes: ",
      "  Workspace: ",
    ],
    "description": "An Item of type \"Task\""
  },

	"Task": {
		"prefix": "Task",
		"body": [
			"${2:TODO} .${1:Summary}:",
      "  Id: ${3:Id}",      
			"  +: {CreatedBy: $4, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: [$4], ForRequirement: , Estimation: $5, RemTime: $5 }",
			"  Details: $0",
      "  Notes: ",
      "  Workspace: ",
		],
		"description": "An Item of type \"Task\""
	},

	"StandupReport": {
		"prefix": "SR",
		"body": [
			"SR${1:yyyymmdd}${2:userName}:",
			"  Was:",
			"  $0#-->Backlog.ComputingTheQuestion.MyTask<: [42m, Lorem ipsum]",
			"  Next:",
			"",
			"  AIOB:",
		],
		"description": "A Standup Report"
	},
	"StandupReport2": {
		"prefix": "SR2",
		"body": [
			"SR${1:yyyymmdd}${2:userName}:",
			"  Was:",
			"    - ${3:#-->Backlog.ComputingTheQuestion.MyTask<: [42m, Lorem ipsum]}",
			"  Next:",
			"    - ${4:-->Backlog.ComputingTheQuestion.MyNextTask<: [42m, Lorem ipsum]}",
			"  AIOB:",
			"  #any other important business"
		],
		"description": "A Standup Report"
	},
	"StandupYamlEntry": {
		"prefix": "StandupEntry",
		"body": [
			"${1:yyyymmdd}:",
			"  Reports:",
			"    ${2:username}:",
			"      Was:",
			"",
			"      Next:",
			"",
			"      AOIB:",
			"",
			"  Meeting Minutes:",
			"    Duration:",
			"    Topics:"
		],
		"description": "A Standup Report"
	},
	
