	"StandupReportEntry": {
		"prefix": "srentry",
		"description": "Outputs a standup report entry",
		"body": [
			"[${1:DURATION}, \"$0\", $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND]",
		]
	},
	"Todo": {
		"prefix": "Todo",
		"body": [
			"TODO .${1:TaskId or Summary}:",
			"  Details: $0",
		],
		"description": "A simple todo Item (of type \"Task\")"
	},
	"BobiTask":{
		"prefix": "brtask",
		"body": [
			"TODO .${1:Summary}:",
			"  Id: ${2:Id}",
			"  +: {CreatedBy: Bobi, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: ${3:Bobi}}",
			"  ForRequirement: $0",
		],
		"description": "Task for a requirement by Bobi"
		},

	"Task": {
		"prefix": "Task",
		"body": [
			"${2:TODO} .${1:TaskId or Summary}:",
			"  +: {CreatedBy:, CreatedAt:, ForRequirement: ,Estimation: ,By: ,Responsible: ,}",
			"  Details: $0",
			"  Result: ",
			"  Notes: ",
			"  WorkLog: ",
			"  #- [userName, timeSpent, description, yyyyMMddThhmm]"
		],
		"description": "An Item of type \"Task\""
	},
	"StandupReport": {
		"prefix": "SR",
		"body": [
			"SR${1:yyyymmdd}${2:userName}:",
			"  Was:",
			"  $0#-->Backlog.ComputingTheQuestion.MyTask<: [42m, Lorem ipsum]",
			"  Next:",
			"",
			"  AIOB:",
		],
		"description": "A Standup Report"
	},
	"StandupReport2": {
		"prefix": "SR2",
		"body": [
			"SR${1:yyyymmdd}${2:userName}:",
			"  Was:",
			"    - ${3:#-->Backlog.ComputingTheQuestion.MyTask<: [42m, Lorem ipsum]}",
			"  Next:",
			"    - ${4:-->Backlog.ComputingTheQuestion.MyNextTask<: [42m, Lorem ipsum]}",
			"  AIOB:",
			"  #any other important business"
		],
		"description": "A Standup Report"
	},
	"StandupYamlEntry": {
		"prefix": "StandupEntry",
		"body": [
			"${1:yyyymmdd}:",
			"  Reports:",
			"    ${2:username}:",
			"      Was:",
			"",
			"      Next:",
			"",
			"      AOIB:",
			"",
			"  Meeting Minutes:",
			"    Duration:",
			"    Topics:"
		],
		"description": "A Standup Report"
	}
}