{
	// Place your snippets for yaml here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"BobiCreatedByAt": {
		"prefix": "bcreated",
		"description": "Outputs an Additional Properties line with usual fields",
		"body": [
			"+: {CreatedBy: Bobi, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: ${1:Bobi}, Tags: [${2:TL}], Estimation: ${3:}, RemTime: ${3:}}"
		]
	},
	"HanaCreatedByAt": {
		"prefix": "hcreated",
		"description": "Outputs an Additional Properties line with usual fields",
		"body": [
			"+: {CreatedBy: Hana, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: ${1:Hana}, Tags: [${2:TL}], Estimation: ${3:}, RemTime: ${3:}}"
		]
	},
	"StandupReportEntry": {
		"prefix": "srentry",
		"description": "Outputs a standup report entry",
		"body": [
			"[${1:DURATION}, \"$0\", $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND]",
		]
	},
	"BobiTask":{
		"prefix": "btask",
    "body": [
      "${2:TODO} .${1:Summary}:",
      "  Id: ${3:Id}",
      "  +: {CreatedBy: Bobi, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: [${4:Bobi}], ForRequirement: , Estimation: $5, RemTime: $5 }",
      "  Details: $0",
      "  Notes: ",
      "  Workspace: ",
    ],
    "description": "An Item of type \"Task\""
  },
  "HanaTask": {
    "prefix": "htask",
    "body": [
      "${2:TODO} .${1:Summary}:",
      "  Id: ${3:Id}",
      "  +: {CreatedBy: Hana, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: [${4:Hana}], ForRequirement: , Estimation: $5, RemTime: $5 }",
      "  Details: $0",
      "  Notes: ",
      "  Workspace: ",
    ],
    "description": "An Item of type \"Task\""
  },

	"Task": {
		"prefix": "Task",
		"body": [
			"${2:TODO} .${1:Summary}:",
      "  Id: ${3:Id}",      
			"  +: {CreatedBy: $4, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: [$4], ForRequirement: , Estimation: $5, RemTime: $5 }",
			"  Details: $0",
      "  Notes: ",
      "  Workspace: ",
		],
		"description": "An Item of type \"Task\""
	},

	"StandupReport": {
		"prefix": "SR",
		"body": [
			"SR${1:yyyymmdd}${2:userName}:",
			"  Was:",
			"  $0#-->Backlog.ComputingTheQuestion.MyTask<: [42m, Lorem ipsum]",
			"  Next:",
			"",
			"  AIOB:",
		],
		"description": "A Standup Report"
	},
	"StandupReport2": {
		"prefix": "SR2",
		"body": [
			"SR${1:yyyymmdd}${2:userName}:",
			"  Was:",
			"    - ${3:#-->Backlog.ComputingTheQuestion.MyTask<: [42m, Lorem ipsum]}",
			"  Next:",
			"    - ${4:-->Backlog.ComputingTheQuestion.MyNextTask<: [42m, Lorem ipsum]}",
			"  AIOB:",
			"  #any other important business"
		],
		"description": "A Standup Report"
	},
	"StandupYamlEntry": {
		"prefix": "StandupEntry",
		"body": [
			"${1:yyyymmdd}:",
			"  Reports:",
			"    ${2:username}:",
			"      Was:",
			"",
			"      Next:",
			"",
			"      AOIB:",
			"",
			"  Meeting Minutes:",
			"    Duration:",
			"    Topics:"
		],
		"description": "A Standup Report"
	},
	"MealLogEntry": {
		"prefix": "LogMeal",
		"body": [
			"Time: $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
			"  Description: $1",
			"  HungerBefore:  ${2:2-Low}",
			"  HungerAfter: ${3:2-Low}",
			"  Amount: ${4:2-Low}"
		],
		"description": "MealLogEntry"
	},
	"MoodLogEntry": {
		"prefix": "LogMood",
		"body": [
			"Time: $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
			"  PeriodLengthInHrs: $1",
			"  Irritability:  ${2:2-Low}",
			"  Drowsiness:: ${3:2-Low}",
			"  Foggyness: ${4:2-Low}",
			"  TummyGassesFeel: ${5:2-Low}",
			"  Bloatedness: ${6:2-Low}",
			"  Farting: ${7:2-Low}",
			"  Headache: ${8:2-Low}",
			"  Hornyness: ${9:2-Low}"
		],
		"description": "MoodLogEntry"
	},

	"PoopikaEntry": {
		"prefix": "LogPoop",
		"body": [
			"Time: $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
			"  Type: $1",
		
		],
		"description": "PoopLogEntry"
	},

	"ExerciseLogEntry": {
		"prefix": "LogExercise",
		"body": [
			"Time: $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
			"  Category: $1",
			"  GarminLink:  $2",
			
		],
		"description": "ExerciseLogEntry"

	},

	"DLogEntry": {
		"prefix": "LogD",
		"body": [
			"Time: $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
			"  NotableThings: $1",
		],
		"description": "DLogEntry"
	},

	"SupplementLogEntry": {
		"prefix": "LogSupplement                   ",
		"body": [
			"Time: $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND",
			"  What: $1",
		],
		"description": "SupplementLogEntry"
	},

	"SleepLogEntry": {
		"prefix": "LogSleep",
		"body": [
			"SleepTime: $1",
			"  GarminLink: $2",
			"  Score: $3",
		],
		"description": "SleepLogEntry"	
	}
}