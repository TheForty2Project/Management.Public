{
	// Place your snippets for yaml here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
  "SiteUpdate":{
    "prefix": "siteupdate",
    "description": "Outputs a SiteUpdateNotes",
    "body": [
      "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE:", 
      "  Summary: $0",
      "  Files:",
      "    Modified:",
      "    Added:",      
    ]
  },
	"BobiCreatedByAt": {
		"prefix": "bcreated",
		"description": "Outputs an Additional Properties line with usual fields",
		"body": [
			"+: {CreatedBy: Bobi, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: ${1:Bobi}, Tags: [${2:TL}], Estimation: ${3:}, RemTime: ${3:}, Importance: ${4:3-Average}}",
      "$0"
		]
	},
  "AnitaCreatedByAt": {
    "prefix": "acreated",
    "description": "Outputs an Additional Properties line with usual fields",
    "body": [
      "+: {CreatedBy: Anita, CreatedAt: $CURRENT_YEAR$CURRENT_MONTH$CURRENT_DATE T $CURRENT_HOUR$CURRENT_MINUTE$CURRENT_SECOND, By: ${1:Anita}, Tags: [${2:TL}], Estimation: ${3:}, RemTime: ${3:}, Importance: ${4:3-Average}}",
      "$0"
    ]
  },


	"HanaCreatedByAt": {
